/*----------------------------------------------------------------------------*/
/* engine.rc -- the Win32 resources compiled into BifrostFM.exe.              */
/*                                                                            */
/* SPDX-License-Identifier: GPL-2.0-or-later                                  */
/* Copyright (c) 2026 B. C. Services                                          */
/*                                                                            */
/* Four resources:                                                            */
/*                                                                            */
/*   1   VERSIONINFO  the version Explorer shows on the exe's Details tab,    */
/*               the same number the program prints for --version.  Its       */
/*               figures come from version.h, which make_version.bat          */
/*               generates into obj\ from version.txt at every build;         */
/*               build_gui.bat names obj\ to the resource compiler as an      */
/*               include folder.                                              */
/*   1   ICON    the program icon (art\BifrostFM.ico).  The lowest-numbered   */
/*               icon in an exe is the one Explorer and the taskbar show      */
/*               (Windows behaviour, as found).                               */
/*   100 RCDATA  the engine DLL, as raw data, so a release build is a single  */
/*               file.  At start-up the program extracts it to a folder of    */
/*               its own under %TEMP%, loads it from there, and deletes that  */
/*               folder on exit -- or, if it cannot then, at the next start   */
/*               (ENG_ExtractEmbedded and ENG_Unload in EngineNative.cs).     */
/*   101 RCDATA  the 256-pixel picture the About window shows                 */
/*               (art\BifrostFM.png), read by ENG_ReadResource.               */
/*                                                                            */
/* The file names below have no folder on purpose: build_gui.bat names        */
/* ..\engine\out (where build_engine.bat leaves the DLL), the art folder and  */
/* obj\ (for version.h) to the resource compiler as include folders, which    */
/* it searches for these files too, so this script names no folder at all.    */
/* Both art files are drawn by ..\tools\MakeIcon.cs.                          */
/*                                                                            */
/* The ids (100, 101) and the type (RCDATA, type 10) are what EngineNative.cs */
/* looks the resources up by (ENG_RESOURCE_ID, ENG_PICTURE_ID,                */
/* ENG_RT_RCDATA); change one side and the other must change with it.         */
/*----------------------------------------------------------------------------*/

/* The version figures and text, generated by make_version.bat at every   */
/* build: BFM_VERSION_MAJOR, _MINOR, _BUILD and BFM_VERSION_TEXT.         */
#include "version.h"

/* The three files compiled in, each found through the include folders. */
1   ICON   "BifrostFM.ico"          // the program icon, from art\ (tools\MakeIcon.cs)
100 RCDATA "bifrost_engine.dll"     // the engine, from ..\engine\out (build_engine.bat) -- ENG_RESOURCE_ID
101 RCDATA "BifrostFM.png"          // the About picture, from art\ (tools\MakeIcon.cs) -- ENG_PICTURE_ID

/* The version resource.  The binary fields are MAJOR,MINOR,BUILD,0 (the    */
/* fourth number is unused); the fixed fields are the plain values a        */
/* windowed program carries, written as numbers so no Windows header is     */
/* needed.  The two string versions are the same text the program prints.   */
1 VERSIONINFO
FILEVERSION     BFM_VERSION_MAJOR,BFM_VERSION_MINOR,BFM_VERSION_BUILD,0
PRODUCTVERSION  BFM_VERSION_MAJOR,BFM_VERSION_MINOR,BFM_VERSION_BUILD,0
FILEFLAGSMASK   0x3F       // VS_FFI_FILEFLAGSMASK: every flag bit is meaningful
FILEFLAGS       0x0        // no flags: not a debug, pre-release or patched build by this field
FILEOS          0x40004    // VOS_NT_WINDOWS32: a 32/64-bit Windows NT program
FILETYPE        0x1        // VFT_APP: an application
FILESUBTYPE     0x0        // no subtype for an application
BEGIN
    BLOCK "StringFileInfo" // the text fields Explorer lists, one block per language
    BEGIN
        BLOCK "040904B0"   // US English, Unicode: the block the Translation below names
        BEGIN
            VALUE "CompanyName",      "B. C. Services"                                                        // the copyright holder
            VALUE "FileDescription",  "BifrostFM - a file manager for ext2 / ext3 / ext4 images and devices"  // the program's one-line description, for the Details tab
            VALUE "FileVersion",      BFM_VERSION_TEXT                                                        // the version text, as --version prints it
            VALUE "InternalName",     "BifrostFM"                                                             // the program's own name
            VALUE "LegalCopyright",   "Copyright (c) 2026 B. C. Services. GPL-2.0-or-later."                  // the copyright and licence, as the file headers state them
            VALUE "OriginalFilename", "BifrostFM.exe"                                                         // the name the exe is built under
            VALUE "ProductName",      "BifrostFM"                                                             // the product's name
            VALUE "ProductVersion",   BFM_VERSION_TEXT                                                        // the same text as FileVersion
        END
    END
    BLOCK "VarFileInfo"    // the languages the string blocks are in
    BEGIN
        VALUE "Translation", 0x409, 1200   // US English (0x409), Unicode code page (1200)
    END
END
