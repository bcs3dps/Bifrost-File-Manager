@echo off
rem ---------------------------------------------------------------------------
rem make_version.bat -- write the version files a BifrostFM build compiles in,
rem from version.txt.
rem
rem SPDX-License-Identifier: GPL-2.0-or-later
rem Copyright (c) 2026 B. C. Services
rem
rem version.txt (beside this script, in the repository) holds the version of
rem the LAST successful build of BifrostFM.exe as one line, MAJOR.MINOR.BUILD,
rem with no line ending.  Every build of the program steps BUILD by one;
rem MAJOR and MINOR change only when a person edits the file (a new release
rem line starts at BUILD 0, and the first build after that is BUILD 1).
rem
rem Usage:
rem     make_version.bat next      the version this build will carry:
rem                                version.txt with BUILD plus one
rem                                (build_gui.bat)
rem     make_version.bat current   version.txt as it stands (a test build,
rem                                which must not use up a number, or
rem                                build_gui.bat release same, a release
rem                                built at a number set by hand)
rem
rem Writes, all into obj\ (intermediates, not in the repository):
rem     Version.cs    APP_BuildVersion.APP_BUILD_VERSION, which Program.cs's
rem                   APP_VERSION is -- the --version text, the About box and
rem                   the debug log's first line
rem     version.h     the same number for engine.rc's VERSIONINFO, which is
rem                   what Explorer shows on the exe's Details tab
rem     version.new   the version as one line with no line ending.  It is NOT
rem                   copied over version.txt here: build_gui.bat does that
rem                   only once the exe has compiled, so a failed build does
rem                   not use up a number.
rem
rem Exit code 0 on success, 1 when version.txt is missing or is not three
rem plain numbers, or the argument is not one of the two above.
rem ---------------------------------------------------------------------------
rem The variables below stay local to this script; the caller learns the
rem version from the files written, not from the environment.
setlocal

rem Into this script's own folder (popd at each exit), so the intermediate
rem folder and the version file are named relative to it.
pushd "%~dp0"
set "OBJ=obj"
set "VERFILE=version.txt"

rem The intermediate folder, made the first time.
if not exist "%OBJ%" mkdir "%OBJ%"

rem No version.txt: nothing to number this build from, so refuse (exit 1)
rem rather than invent a version.
if not exist "%VERFILE%" (
    echo missing %VERFILE%
    goto :error
)

rem Read version.txt and split it at the dots.  Each part is checked to be a
rem plain number with no leading zero: set /a reads a leading zero as octal,
rem so "08" would fail and "010" would silently become 8.
set "VER="
set /p VER=<"%VERFILE%"
set "VMAJ="
set "VMIN="
set "VBLD="
set "VEXTRA="
rem The line split at the dots, in one pass of the loop: a fourth part is
rem caught in VEXTRA rather than ignored, so "1.2.3.4" is refused.
for /f "tokens=1-4 delims=." %%A in ("%VER%") do (
    set "VMAJ=%%A"
    set "VMIN=%%B"
    set "VBLD=%%C"
    set "VEXTRA=%%D"
)
rem Exactly three parts, each a plain number; a missing part arrives empty
rem and :NUMBER refuses it.
if defined VEXTRA goto :badversion
call :NUMBER %VMAJ%
if errorlevel 1 goto :badversion
call :NUMBER %VMIN%
if errorlevel 1 goto :badversion
call :NUMBER %VBLD%
if errorlevel 1 goto :badversion

rem The mode: step BUILD for a build of the program, or keep it as it is.
if /i "%~1"=="next" goto :step
if /i "%~1"=="current" goto :write
echo usage: make_version.bat next ^| current
goto :error

:step
rem "next": BUILD plus one (safe in set /a now that it has no leading zero).
set /a VBLD=VBLD+1

:write
rem The version this build carries, as text, for all three files.
set "VNEW=%VMAJ%.%VMIN%.%VBLD%"

rem Version.cs: one constant, in a class of its own so Program.cs keeps the
rem name every caller uses (APP_clsProgram.APP_VERSION) and only points it here.
>"%OBJ%\Version.cs"  echo /*----------------------------------------------------------------------------*/
>>"%OBJ%\Version.cs" echo /* Version.cs -- GENERATED by make_version.bat at build time; never edit it,  */
>>"%OBJ%\Version.cs" echo /* edit version.txt.  The version this build of BifrostFM carries,            */
>>"%OBJ%\Version.cs" echo /* MAJOR.MINOR.BUILD, read by APP_clsProgram.APP_VERSION.                     */
>>"%OBJ%\Version.cs" echo /*----------------------------------------------------------------------------*/
>>"%OBJ%\Version.cs" echo.
>>"%OBJ%\Version.cs" echo namespace BifrostFM
>>"%OBJ%\Version.cs" echo {
>>"%OBJ%\Version.cs" echo     internal static class APP_BuildVersion
>>"%OBJ%\Version.cs" echo     {
>>"%OBJ%\Version.cs" echo         internal const string APP_BUILD_VERSION = "%VNEW%";   // this build's version, MAJOR.MINOR.BUILD
>>"%OBJ%\Version.cs" echo     }
>>"%OBJ%\Version.cs" echo }

rem version.h: the three numbers for VERSIONINFO's binary fields and the text
rem for its strings.
>"%OBJ%\version.h"  echo /* version.h -- GENERATED by make_version.bat at build time; never edit it. */
>>"%OBJ%\version.h" echo #define BFM_VERSION_MAJOR %VMAJ%
>>"%OBJ%\version.h" echo #define BFM_VERSION_MINOR %VMIN%
>>"%OBJ%\version.h" echo #define BFM_VERSION_BUILD %VBLD%
>>"%OBJ%\version.h" echo #define BFM_VERSION_TEXT "%VNEW%"

rem version.new: the version with no line ending, ready to become version.txt.
rem set /p with no input prints its prompt and no line break; it also sets
rem errorlevel 1 when it reads nothing, which is expected and not a failure.
<nul >"%OBJ%\version.new" set /p "=%VNEW%"

rem Done: the version shown in the build's output, and success.  The exit
rem stops the script before the labels below, and returns 0 although the
rem set /p above left errorlevel 1.
echo version %VNEW%
popd
endlocal
exit /b 0

rem ---------------------------------------------------------------------------
rem NUMBER: errorlevel 0 when the argument is "0" or a number with no leading
rem zero, 1 otherwise (an empty argument included).
rem ---------------------------------------------------------------------------
:NUMBER
rem An empty part (a missing one) is refused at once.
if "%~1"=="" exit /b 1
rem The whole line must match: exactly "0", or 1-9 then any digits.  No
rem space before the "|", so echo hands findstr the text with nothing after
rem it; findstr's own errorlevel (0 matched, 1 not) is the answer.
echo %~1| findstr /r /x /c:"0" /c:"[1-9][0-9]*" >nul
exit /b %errorlevel%

rem version.txt is not three plain numbers: say what was read, then fail.
:badversion
echo %VERFILE% must be one line, MAJOR.MINOR.BUILD (three plain numbers): "%VER%"

rem Every refusal ends here: back to the caller's folder, exit 1, and no
rem file is written (the checks all come before the first write).
:error
popd
endlocal
exit /b 1
